import std::fixedbytes::bytes32;
import std::addr::addr;

const ecrecover = fn (hash: bytes32, v: u256, r: u256, s: u256) Option(addr) {
    let ptr = @malloc_uninit(128)
    @mstore32(ptr +% 0, hash.raw);
    @mstore32(ptr +% 32, v);
    @mstore32(ptr +% 64, r);
    @mstore32(ptr +% 96, s);

    if @evm_staticcall(@evm_gas(), 0x01, ptr, 128, ptr, 32) == 0 {
        return None(address)
    }

    let signer = @mload32(ptr);
    Some(addr, addr { raw: signer })
};
